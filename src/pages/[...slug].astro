---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import { getPublishedBlogPosts } from "@/lib/blog-collection";
import "@wix/wix-vibe-plugins/plugins-vars.css";
import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

export async function getStaticPaths() {
  const { readFileSync } = await import('node:fs');
  const router = readFileSync(`${process.cwd()}/src/components/Router.tsx`, 'utf8');
  const routes = [...router.matchAll(/path: "([^"]+)"/g)]
    .map(match => match[1]).filter(path => !['/', '*'].includes(path) && !path.includes(':'));
  const posts = (await getPublishedBlogPosts()).map(post => `blog/${post.slug}`);
  return [undefined, ...routes, ...posts].map(slug => ({ params: { slug } }));
}

const blogPosts = await getPublishedBlogPosts();

const isPages = import.meta.env.PUBLIC_GITHUB_PAGES;
const SEO = isPages ? undefined : (await import('@wix/seo/components')).SEO;
const seoTagsServiceConfig = isPages ? undefined : await (await import('@wix/seo/services')).loadSEOTagsServiceConfig({
  pageUrl: Astro.url.href,
  itemData: {
    pageName: 'Home',
  },
});
---

<html lang="en" class="w-full h-full">
  <head>
    <Head />
    {SEO && <SEO.Tags seoTagsServiceConfig={seoTagsServiceConfig} slot="seo-tags" />}
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter blogPosts={blogPosts} client:only="react" />
    </div>
  </body>
</html>
